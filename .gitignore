# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.venv/
venv/

# Build / install
build/
dist/

# Output artefacts. These live in this directory but are NEVER repo content -- every
# entry below is ignored, so a 20+ GB output tree can sit here safely.
#
# As of 2026-09-09 there is ONE output tree for all server-side work:
#     /exp/annie/app/users/dajana/AmBeNeutronsAnalysis/ambe_output
# Before that, outputs were split across three places -- ambe_output/ and logs/ in a
# sibling `AmBeNeutronAnalysis` (no "s"), TriggerSummary/ + verbose/ +
# EventAmBeNeutronCandidatesData/ here, and a stray
# /exp/annie/app/users/dajana/ambe_output -- so no path could be guessed. They are
# merged here, both old locations are now symlinks to this tree, and all 49
# server-side configs resolve under it.
#
# Configs with /Users/... or /sessions/... output_root are laptop / sandbox runs and
# are deliberately NOT pointed at this tree.
EventAmBeNeutronCandidatesData/
TriggerSummary/
verbose/
OutputPlots/
mc_results/
mc_parquet/
ambe_output/
beamoff/
mc_steven/
optics_beamcluster_benchmark_smoke/
logs/
*.log
*.pdf
*.png
*.parquet
*.npz

# PRESENTATION_PLOTS/ is a collected-figure tree. Any script snapshotted into it by
# collect_presentation_plots.py is a stale copy of the version tracked at the repo
# root -- ignore those so git carries exactly one copy of each script. The per-deck
# README.md files ARE repo content and stay tracked.
PRESENTATION_PLOTS/*.py

# CSVs that are outputs (keep CSVs under configs/ or tests/ if they're inputs)
*.csv
!configs/**/*.csv
!tests/**/*.csv

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Local data trees (BeamCluster ROOT files + per-run waveform subdirs).
# newPMTPhysics/ is ~70 GB and test/ ~2.6 GB — inputs, never repo content.
newPMTPhysics/
test/
